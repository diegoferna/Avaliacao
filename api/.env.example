NODE_ENV=development
API_PORT=3001
TRUST_PROXY=0

# URL publica (producao): https://seu-dominio.gov.br
# PUBLIC_API_URL=

# Prefixo extra no Nginx (ex.: /avaliacao-api) — ver doc/deploy-swagger-nginx.md
# API_INDEX_PREFIX=

# Pool da aplicação (migrations, api_clients, api_logs)
DATABASE_URL=postgresql://postgres:senha@localhost:5433/avaliacao_saude
# ou:
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=avaliacao_saude
# DB_USER=postgres
# DB_PASSWORD=senha

# Pool read-only para consultas de parceiros
PARTNER_DB_USER=partner_api_ro
PARTNER_DB_PASSWORD=senha_readonly
PARTNER_DB_HOST=localhost
PARTNER_DB_PORT=5433
PARTNER_DB_NAME=avaliacao_saude
# ou PARTNER_DATABASE_URL=postgresql://partner_api_ro:...@localhost:5433/avaliacao_saude

# Admin (fallback HTTP)
INTERNAL_ADMIN_KEY=altere_este_segredo_longo
ADMIN_ALLOWED_IPS=

# Rate limits
PARTNER_RATE_LIMIT_MAX=100
PARTNER_RATE_LIMIT_WINDOW=1 minute
ADMIN_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_WINDOW=1 minute
